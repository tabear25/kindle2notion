{
  "id": "/",
  "name": "Kindle ハイライト同期",
  "short_name": "ハイライト",
  "description": "Kindle や紙の本のハイライトを Notion と NotebookLM 用スプレッドシートへ取り込みます。",
  "lang": "ja",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#edf4ff",
  "theme_color": "#0ea5e9",
  "icons": [
    { "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/static/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Kindle のハイライトを今すぐ同期",
      "short_name": "Kindle同期",
      "description": "バックエンドの起動を待って、そのまま同期を開始します。",
      "url": "/?action=sync",
      "icons": [
        { "src": "/static/icons/shortcut-sync-96.png", "sizes": "96x96", "type": "image/png", "purpose": "any" },
        { "src": "/static/icons/shortcut-sync-maskable-96.png", "sizes": "96x96", "type": "image/png", "purpose": "maskable" }
      ]
    },
    {
      "name": "紙の本のハイライトを手動で追加",
      "short_name": "手動で追加",
      "description": "Kindle にない本のハイライトを入力します。",
      "url": "/?action=manual",
      "icons": [
        { "src": "/static/icons/shortcut-manual-96.png", "sizes": "96x96", "type": "image/png", "purpose": "any" },
        { "src": "/static/icons/shortcut-manual-maskable-96.png", "sizes": "96x96", "type": "image/png", "purpose": "maskable" }
      ]
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  }
}
